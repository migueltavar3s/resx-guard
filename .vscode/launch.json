{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Extension (sample project)",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/apps/vscode",
        "${workspaceFolder}/fixtures/sample-project"
      ],
      "outFiles": ["${workspaceFolder}/apps/vscode/dist/**/*.js"],
      "preLaunchTask": "npm: build"
    }
  ]
}
